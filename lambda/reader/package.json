{
  "name": "reader-function",
  "version": "1.0.0",
  "private": true,
  "description": "ReaderFunction handler: reports the size of one object under the readable S3 prefix. Packaged as an arm64 container image. Self-contained: its dependencies are not shared with the CDK app.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node22 --minify --outfile=dist/index.js",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "typescript": "~7.0.2"
  }
}
